+    /**
+     * JIT-friendly cached Thumb dispatcher. The full Thumb decoder is intentionally large
+     * because it preserves all rare instruction families. Cached basic blocks already carry
+     * a coarse decode kind, so route the common families through small helpers instead of
+     * re-entering the 3.5KB decoder for every guest instruction.
+     */
+    private fun stepThumbCachedDecoded(pc: Int, op: Int, decodeKind: Int) {
+        when (decodeKind) {
+            BasicBlockDecodeCache.THUMB_BL_PREFIX -> thumbCachedBlPrefix(pc, op)
+            BasicBlockDecodeCache.THUMB_BL_SUFFIX -> thumbCachedBlSuffix(pc, op)
+            BasicBlockDecodeCache.THUMB_BLX_SUFFIX -> thumbCachedBlxSuffix(pc, op)
+            BasicBlockDecodeCache.THUMB_SHIFT -> { r[15] = pc + 2; thumbCachedShift(op) }
+            BasicBlockDecodeCache.THUMB_ADD_SUB -> { r[15] = pc + 2; thumbCachedAddSub(op) }
+            BasicBlockDecodeCache.THUMB_IMM8 -> { r[15] = pc + 2; thumbCachedImm8(op) }
+            BasicBlockDecodeCache.THUMB_ALU -> { r[15] = pc + 2; thumbCachedAlu(op) }
+            BasicBlockDecodeCache.THUMB_HIGH_REG -> { r[15] = pc + 2; thumbCachedHighReg(pc, op) }
+            BasicBlockDecodeCache.THUMB_PC_LDR -> thumbCachedPcLdr(pc, op)
+            BasicBlockDecodeCache.THUMB_LOAD_STORE_REG -> { r[15] = pc + 2; thumbCachedLoadStoreReg(op) }
+            BasicBlockDecodeCache.THUMB_LOAD_STORE_IMM -> { r[15] = pc + 2; thumbCachedLoadStoreImm(op) }
+            BasicBlockDecodeCache.THUMB_HALFWORD_IMM -> { r[15] = pc + 2; thumbCachedHalfwordImm(op) }
+            BasicBlockDecodeCache.THUMB_SP_REL -> { r[15] = pc + 2; thumbCachedSpRelative(op) }
+            BasicBlockDecodeCache.THUMB_LOAD_ADDR -> thumbCachedLoadAddr(pc, op)
+            BasicBlockDecodeCache.THUMB_SP_ADJ -> thumbCachedSpAdjust(pc, op)
+            BasicBlockDecodeCache.THUMB_PUSH_POP -> { r[15] = pc + 2; thumbCachedPushPop(op) }
+            BasicBlockDecodeCache.THUMB_MULTI -> { r[15] = pc + 2; thumbCachedMulti(op) }
+            BasicBlockDecodeCache.THUMB_COND_BRANCH -> thumbCachedCondBranch(pc, op)
+            BasicBlockDecodeCache.THUMB_BRANCH -> thumbCachedBranch(pc, op)
+            else -> stepThumbDecoded(pc, op, decodeKind)
+        }
+    }
+
+    private fun thumbCachedBlPrefix(pc: Int, op: Int) {
+        r[15] = pc + 2
+        var hi = op and 0x07ff
+        if ((hi and 0x0400) != 0) hi = hi or -0x800
+        thumbBlHigh = pc + 4 + (hi shl 12)
+        thumbBlHighValid = true
+    }
+
+    private fun thumbCachedBlSuffix(pc: Int, op: Int) {
+        if (!thumbBlHighValid) { stepThumbDecoded(pc, op, BasicBlockDecodeCache.THUMB_BL_SUFFIX); return }
+        r[14] = (pc + 2) or 1
+        r[15] = (thumbBlHigh + ((op and 0x07ff) shl 1)) and -2
+        thumb = true
+        thumbBlHighValid = false
+    }
+
+    private fun thumbCachedBlxSuffix(pc: Int, op: Int) {
