@@ -0,0 +1,27 @@
+package vxpcore
+
+import java.io.File
+
+fun main() {
+    val mem = GuestMemory()
+    mem.map(0x1000, 0x1000, read = true, write = true, exec = true)
+    val rt = MreRuntime(mem, File("/mnt/data/vxp-eventloop-hard-wall-regression").apply { deleteRecursively(); mkdirs() })
+    val cpu = ArmCpu(mem, rt)
+
+    // vm_main is deliberately stuck in ARM `B .`. Event-loop maxRuntimeMs must be
+    // enforceable while the callback is still executing, not only after it returns.
+    mem.write32(0x1000, 0xEAFFFFFE.toInt(), force = true)
+    val started = System.nanoTime()
+    val stats = MreEventLoop(
+        cpu = cpu,
+        runtime = rt,
+        maxInstructionsPerCallback = 1_000_000_000L,
+        maxRuntimeMs = 60L
+    ).run(0x1000)
+    val elapsedMs = (System.nanoTime() - started) / 1_000_000.0
+
+    check(stats.timedOut) { "event loop did not report timeout: $stats" }
+    check(elapsedMs < 2_000.0) { "event-loop hard wall did not interrupt promptly: ${elapsedMs}ms" }
+    check(cpu.callbackWatchdogStats().hardLimitFailures == 1L) { cpu.callbackWatchdogStats().toString() }
+    println("[OK] event-loop hard watchdog interrupted stuck vm_main in %.3f ms".format(elapsedMs))
+}