+++ b/tests/jvm/GuestCallbackHardWallRegression.kt
@@ -0,0 +1,24 @@
+package vxpcore
+
+import java.io.File
+
+fun main() {
+    val mem = GuestMemory()
+    mem.map(0x1000, 0x1000, read = true, write = true, exec = true)
+    val rt = MreRuntime(mem, File("/mnt/data/vxp-hard-wall-regression").apply { deleteRecursively(); mkdirs() })
+    val cpu = ArmCpu(mem, rt)
+
+    // ARM: B . (EAFFFFFE). A huge instruction budget would otherwise spin for a long time.
+    mem.write32(0x1000, 0xEAFFFFFE.toInt(), force = true)
+    val deadline = System.nanoTime() + 40_000_000L
+    val started = System.nanoTime()
+    val failure = runCatching {
+        cpu.callGuest(0x1000, 1_000_000_000L, deadline)
+    }.exceptionOrNull()
+    val elapsedMs = (System.nanoTime() - started) / 1_000_000.0
+
+    check(failure is ArmCpu.GuestCallbackWallTimeoutException) { "unexpected failure=$failure" }
+    check(elapsedMs < 2_000.0) { "hard wall did not interrupt promptly: ${elapsedMs}ms" }
+    check(cpu.callbackWatchdogStats().hardLimitFailures == 1L) { cpu.callbackWatchdogStats().toString() }
+    println("[OK] guest callback hard wall interrupted infinite callback in %.3f ms".format(elapsedMs))
+}
