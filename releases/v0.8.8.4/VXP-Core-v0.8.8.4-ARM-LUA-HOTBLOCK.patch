+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+BASELINE_JAR="${1:?baseline jar required}"
+CANDIDATE_JAR="${2:?candidate jar required}"
+VXP_FILE="${3:?VXP file required}"
+
+FRAMES="${PERF_FRAMES:-40}"
+TRIALS="${PERF_TRIALS:-6}"
+CALLBACK_BUDGET="${PERF_CALLBACK_BUDGET:-20000000}"
+MIN_SPEEDUP_PCT="${PERF_MIN_SPEEDUP_PCT:-2.0}"
+JVM_XMS="${PERF_JVM_XMS:-512m}"
+JVM_XMX="${PERF_JVM_XMX:-512m}"
+
+BUILD_DIR="$ROOT/build/perf-gate"
+BENCH_JAR="$BUILD_DIR/fixed-frame-performance.jar"
+mkdir -p "$BUILD_DIR"
+
+kotlinc \
+  -language-version 2.0 \
+  -Xskip-prerelease-check \
+  -Xallow-unstable-dependencies \
+  -cp "$CANDIDATE_JAR" \
+  "$ROOT/tests/jvm/FixedFramePerformanceBenchmark.kt" \
+  -include-runtime \
+  -d "$BENCH_JAR"
+
+run_one() {
+  local jar="$1"
+  local label="$2"
+  local out="$BUILD_DIR/$label.txt"
+  java -Xms"$JVM_XMS" -Xmx"$JVM_XMX" \
+    -cp "$jar:$BENCH_JAR" \
+    vxpcore.FixedFramePerformanceBenchmarkKt \
+    "$VXP_FILE" "$FRAMES" "$TRIALS" "$CALLBACK_BUDGET" | tee "$out"
+}
+
+run_one "$BASELINE_JAR" baseline
+run_one "$CANDIDATE_JAR" candidate
+
+python3 - "$BUILD_DIR/baseline.txt" "$BUILD_DIR/candidate.txt" "$MIN_SPEEDUP_PCT" <<'PY'
+import re, sys
+base_path, cand_path, min_pct = sys.argv[1], sys.argv[2], float(sys.argv[3])
+
+def result(path):
+    text = open(path, encoding="utf-8").read()
+    lines = [x for x in text.splitlines() if x.startswith("RESULT ")]
+    if len(lines) != 1:
+        raise SystemExit(f"missing unique RESULT in {path}")
+    line = lines[0]
+    def grab(name):
+        m = re.search(rf"\b{name}=([^\s]+)", line)
+        if not m:
+            raise SystemExit(f"missing {name} in {path}")
+        return m.group(1)
+    return float(grab("medianWarmMips")), grab("signature"), line
+
+base_mips, base_sig, base_line = result(base_path)
+cand_mips, cand_sig, cand_line = result(cand_path)
+if base_sig != cand_sig:
+    raise SystemExit(f"FAIL semantic signature changed: baseline={base_sig} candidate={cand_sig}")
+speedup = (cand_mips / base_mips - 1.0) * 100.0
+print(f"PERF_GATE baselineMips={base_mips:.3f} candidateMips={cand_mips:.3f} speedupPct={speedup:.2f} minPct={min_pct:.2f}")
+if speedup + 1e-9 < min_pct:
+    raise SystemExit("FAIL candidate did not meet minimum speedup")
+print("PASS fixed-frame semantic + performance gate")
+PY
