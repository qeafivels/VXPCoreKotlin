+package vxpcore
+
+import java.io.File
+import java.util.Locale
+
+/**
+ * Deterministic fixed-frame performance benchmark for a user-supplied VXP.
+ *
+ * Usage:
+ *   FixedFramePerformanceBenchmarkKt <file.vxp> [frames=40] [trials=6] [maxInstructionsPerCallback=20000000]
+ *
+ * Trial 0 is a JVM warm-up trial. RESULT reports medians over trials 1..N-1.
+ * Every trial must produce the exact same guest-work signature.
+ */
+fun main(args: Array<String>) {
+    Locale.setDefault(Locale.US)
+    val vxpFile = File(requireNotNull(args.getOrNull(0)) {
+        "usage: <file.vxp> [frames=40] [trials=6] [maxInstructionsPerCallback=20000000]"
+    })
+    val targetFrames = args.getOrNull(1)?.toInt() ?: 40
+    val trials = args.getOrNull(2)?.toInt() ?: 6
+    val callbackBudget = args.getOrNull(3)?.toLong() ?: 20_000_000L
+    require(targetFrames > 0)
+    require(trials >= 3) { "at least 3 trials are required" }
+    require(callbackBudget > 0)
+
+    val bytes = vxpFile.readBytes()
+    val prepared = VxpCoreLibrary.prepare(bytes)
+    require(prepared.backend == VxpBackendType.ELF_ARM) {
+        "fixed-frame ARM benchmark requires ELF_ARM, got ${prepared.backend}"
+    }
+
+    data class Trial(
+        val ms: Double,
+        val mips: Double,
+        val frames: Long,
+        val instructions: Long,
+        val events: Long,
+        val timers: Long,
+        val timedOut: Boolean
+    ) {
+        fun signature(): String = "$frames/$instructions/$events/$timers/$timedOut"
+    }
+
+    val results = ArrayList<Trial>(trials)
+    repeat(trials) { trial ->
+        val storage = File(
+            System.getProperty("java.io.tmpdir"),
+            "vxp-perf-${vxpFile.nameWithoutExtension}-$trial"
+        ).apply {
+            deleteRecursively()
+            mkdirs()
+        }
+        val engine = VxpCoreEngine(storage)
+        var seenFrames = 0
+        val start = System.nanoTime()
+        val result = engine.runPrepared(
+            prepared = prepared,
+            fileName = vxpFile.name,
+            maxInstructionsPerCallback = callbackBudget,
+            maxRuntimeMs = 60_000L
+        ) {
+            seenFrames++
+            if (seenFrames >= targetFrames) engine.requestStop(0)
+        }
+        val elapsed = System.nanoTime() - start
+        val ms = elapsed / 1_000_000.0
+        val mips = result.instructions.toDouble() / (elapsed / 1_000_000_000.0) / 1_000_000.0
+        val t = Trial(
+            ms = ms,
+            mips = mips,
+            frames = result.frames,
+            instructions = result.instructions,
+            events = result.events,
+            timers = result.timerCallbacks,
+            timedOut = result.timedOut
+        )
